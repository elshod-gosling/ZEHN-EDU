rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function emailUser() {
      return request.auth != null && request.auth.token.email is string
        && (request.auth.token.firebase.sign_in_provider == 'password'
          || (request.auth.token.firebase.sign_in_provider == 'google.com'
            && request.auth.token.email_verified == true));
    }
    function owns(uid) { return emailUser() && request.auth.uid == uid; }
    function developer() {
      return emailUser() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/policy/access)
        && request.auth.token.email == get(/databases/$(database)/documents/policy/access).data.developerEmail;
    }
    function shape(d) {
      return d.keys().hasOnly(['role','credits','earned','cursor','phase','questionId','answer','startedAt','lastEarnAt','passUntil','updatedAt'])
        && d.keys().hasAll(['role','credits','earned','cursor','phase','questionId','answer','startedAt','lastEarnAt','passUntil','updatedAt'])
        && d.role in ['student','developer'] && d.credits is int && d.credits >= 0
        && d.earned is int && d.earned >= 0 && d.cursor is int && d.cursor >= 0
        && d.phase in ['idle','learning'] && d.questionId is string && d.answer is string && d.answer.size() <= 100
        && d.startedAt is timestamp && d.lastEarnAt is timestamp && d.passUntil is timestamp
        && d.updatedAt == request.time;
    }
    match /accounts/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid) && shape(request.resource.data)
        && request.resource.data.role == 'student'
        && request.resource.data.credits == 0 && request.resource.data.earned == 0 && request.resource.data.cursor == 0
        && request.resource.data.phase == 'idle' && request.resource.data.questionId == '' && request.resource.data.answer == ''
        && request.resource.data.startedAt == request.time && request.resource.data.lastEarnAt == request.time
        && request.resource.data.passUntil == request.time;
      allow update: if owns(uid) && shape(request.resource.data) && (
        promote() || (request.resource.data.role == resource.data.role && (heartbeat() || startRound() || earn() || redeem()))
      );
      function changes() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function promote() { return developer() && request.resource.data.role == 'developer' && changes().hasOnly(['role','updatedAt']); }
      function heartbeat() { return changes().hasOnly(['updatedAt']); }
      function startRound() {
        let d = request.resource.data;
        return changes().hasOnly(['phase','questionId','answer','startedAt','updatedAt'])
          && d.phase == 'learning' && d.answer == '' && d.startedAt == request.time
          && exists(/databases/$(database)/documents/answerKeys/$(d.questionId))
          && get(/databases/$(database)/documents/answerKeys/$(d.questionId)).data.cycle == resource.data.cursor % 8;
      }
      function earn() {
        let d = request.resource.data;
        return changes().hasOnly(['phase','answer','credits','earned','cursor','lastEarnAt','updatedAt'])
          && resource.data.phase == 'learning' && d.phase == 'idle'
          && request.time >= resource.data.startedAt + duration.value(60,'s')
          && request.time >= resource.data.lastEarnAt + duration.value(60,'s')
          && d.answer == get(/databases/$(database)/documents/answerKeys/$(resource.data.questionId)).data.answer
          && d.credits == resource.data.credits + 10 && d.earned == resource.data.earned + 10
          && d.cursor == resource.data.cursor + 1 && d.lastEarnAt == request.time;
      }
      function redeem() {
        let d = request.resource.data;
        return changes().hasOnly(['credits','passUntil','updatedAt']) && resource.data.credits >= 100
          && d.credits == resource.data.credits - 100 && resource.data.passUntil <= request.time
          && d.passUntil >= request.time + duration.value(297,'s')
          && d.passUntil <= request.time + duration.value(303,'s');
      }
    }
    match /questions/{id} { allow read: if emailUser(); }
    // Only the Firebase project administrator can seed these via the Admin SDK.
    // A developer in the website does not gain Firebase administrative credentials.
    match /answerKeys/{id} { allow read, write: if false; }
    match /policy/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
